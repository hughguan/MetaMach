#!/bin/bash
# MetaMach pre-push hook — runs CI gates before every push.
# Install: ln -sf ../../scripts/pre-push .git/hooks/pre-push
set -euo pipefail

TOPDIR="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
cd "$TOPDIR/janus" || exit 0

# Determine what files changed in this push (matching CI paths-ignore).
# Skip the heavy test phases for docs-only changes; still run fmt + clippy.
# Uses git diff-tree on the latest commit, which works reliably from any
# hook context without needing remote ref access.
# Determine what files changed in this push (matching CI paths-ignore).
# Skip the heavy test phases for docs-only changes; still run fmt + clippy.
# Uses git merge-base to find all files across all unpushed commits without
# needing network access (merge-base is purely local).
skip_tests=false
base=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
if [ -n "$base" ]; then
    changed_files=$(git diff --name-only "$base"..HEAD 2>/dev/null || true)
else
    # Fallback: check the latest commit only.
    changed_files=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)
fi
if [ -n "$changed_files" ]; then
    non_doc=$( (echo "$changed_files" | grep -v '^docs/' | grep -v '\.md$' | grep -v '^$' || true) | wc -l | tr -d ' ')
    if [ "$non_doc" -eq 0 ]; then
        skip_tests=true
        echo "=== Docs/md only — skipping test phases (matching CI paths-ignore) ==="
    fi
fi

echo "=== M0: cargo fmt --check ==="
cargo fmt --all -- --check

echo "=== M1: cargo clippy -D warnings ==="
cargo clippy --all-targets -- -D warnings

if $skip_tests; then
    echo ""
    echo "✅ All CI gates green — safe to push"
    exit 0
fi

# Auto-provision PG if pg_ctl/initdb are available (local dev).
# In CI this is a no-op — DATABASE_URL is already set globally.
sock_dir="${METAMACH_PG_SOCKET_DIR:-$HOME/.local/state/herdr/plugins/metamach.janus/pg_socket}"
if [ -z "${DATABASE_URL:-}" ]; then
    if [ -d "$sock_dir" ]; then
        encoded_sock=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$sock_dir', safe=''))")
        export DATABASE_URL="postgres://metamach_admin@${encoded_sock}/metamach_db"
        export METAMACH_PG_SOCKET_DIR="$sock_dir"
        export PGHOST="$sock_dir"
        echo "=== PG socket found at $sock_dir ==="
    elif command -v pg_ctl >/dev/null 2>&1 && command -v initdb >/dev/null 2>&1; then
        echo "=== PG not running — attempting make db-init ==="
        if make -s -C "$(git rev-parse --show-toplevel)" db-init 2>/dev/null; then
            encoded_sock=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$sock_dir', safe=''))")
            export DATABASE_URL="postgres://metamach_admin@${encoded_sock}/metamach_db"
            export METAMACH_PG_SOCKET_DIR="$sock_dir"
            export PGHOST="$sock_dir"
            echo "=== PG ready ==="
        else
            echo "=== PG init failed — PG-gated tests will skip ==="
        fi
    fi
else
    echo "=== PG already available ==="
fi

echo "=== M2–M5: cargo test --workspace ==="
# Run tests sequentially when PG is available — parallel daemon spawning
# can exhaust local PG connections (CI's Docker PG handles parallelism fine).
if [ -n "${DATABASE_URL:-}" ] || [ -n "${METAMACH_PG_SOCKET_DIR:-}" ]; then
    RUST_TEST_THREADS=1 cargo test --workspace
else
    cargo test --workspace
fi

echo ""
echo "✅ All CI gates green — safe to push"
